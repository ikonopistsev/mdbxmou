{
  "main": "lib/nativemou.js",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/nativemou.d.cts",
        "default": "./lib/nativemou.js"
      }
    },
    "./async": {
      "import": {
        "types": "./lib/async.d.mts",
        "default": "./lib/async.mjs"
      },
      "require": {
        "types": "./lib/async.d.cts",
        "default": "./lib/mdbx_evn_async.js"
      }
    },
    "./nativemou": {
      "import": {
        "types": "./lib/nativemou.d.mts",
        "default": "./lib/nativemou.js"
      },
      "require": {
        "types": "./lib/nativemou.d.cts",
        "default": "./lib/nativemou.js"
      }
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types.d.ts"
    }
  },
  "files": [
    "lib/**/*",
    "src/**/*",
    "deps/**/*",
    "!deps/**/.git",
    "test/stage5-benchmark.js",
    "build.js",
    "CMakeLists.txt",
    "GETVIEW.md",
    "PERFORMANCE.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "cmake-js": "^8.0.0",
    "node-addon-api": "8.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "msgpackr": "^1.11.9",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "e3": "node ./test/e3.js",
    "e33": "node ./test/e33.js",
    "e4": "node ./test/e4.js",
    "e4async": "node ./test/e4async.mjs",
    "e5": "node ./test/e5.js",
    "e6": "node ./test/e6.js",
    "e7": "node ./test/e7.js",
    "e8": "node ./test/e8.js",
    "e9": "node ./test/e9.js",
    "test:types": "node ./test/types/run.mjs",
    "test:query-bulk": "node test/query-bulk.js",
    "test:cursor-delete": "node test/cursor-delete.js",
    "test:cursor-seek-both": "node ./test/cursor-seek-both.js",
    "test:db-raw": "node ./test/db-raw.js",
    "test:cursor-raw": "node ./test/cursor-raw.js",
    "test:worker-isolates": "node ./test/worker-isolates.js --run-suite",
    "test:libmdbx-0143": "node ./test/libmdbx-0143.js --run-suite",
    "test:commit-and-start-read": "node ./test/commit-and-start-read.js",
    "test:checkpoint": "node ./test/checkpoint.js --run-suite",
    "test:log-level": "node ./test/log-level.js",
    "test:sync-ex": "node ./test/sync-ex.js",
    "test:query-buffer-keys": "node --expose-gc ./test/query-buffer-keys.js",
    "test:query-result": "node --expose-gc ./test/query-result.js",
    "test:query-stack": "node --expose-gc ./test/query-stack.js",
    "test:copy-to": "node ./test/copy-to.js",
    "test:copy-to:native": "node ./test/copy-to.js --native",
    "benchmark:stage5": "node --expose-gc ./test/stage5-benchmark.js",
    "build": "node build.js",
    "build:copy-tests": "node build.js --copy-testing",
    "build-dev": "node build-dev.js",
    "install": "node build.js",
    "test:query-rejection": "node test/query-rejection.js"
  },
  "gypfile": true,
  "name": "mdbxmou",
  "version": "0.5.8",
  "engines": {
    "node": ">=22.9.0"
  },
  "description": "Node bindings for mdbx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikonopistsev/mdbxmou.git"
  },
  "keywords": [
    "mdbx",
    "libmdbx",
    "database",
    "db",
    "kv",
    "bindings",
    "embedded"
  ],
  "author": "Igor Ikonopistsev",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ikonopistsev/mdbxmou/issues"
  },
  "homepage": "https://github.com/ikonopistsev/mdbxmou#readme"
}
